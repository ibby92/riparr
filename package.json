{
  "name": "riparr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev\" \"tsx watch worker/index.ts\"",
    "dev:web": "next dev",
    "worker": "tsx worker/index.ts",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/worker.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "lucide-react": "^1.54.0",
    "megajs": "^1.3.10",
    "next": "16.4.0",
    "p-queue": "^9.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
